<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8">
    <title>Gaming Gaiden</title>
    <link
      rel="icon"
      type="image/x-icon"
      href="./resources/images/favicon.ico"
    />
    <link rel="stylesheet" href="./resources/css/theme.css" />
    <link rel="stylesheet" href="./resources/css/common.css" />
    <link rel="stylesheet" href="./resources/css/AllGames.css" />
    <link rel="stylesheet" href="./resources/css/libraries/jquery.dataTables.css" />
    <script src="./resources/js/libraries/jquery-3.7.1.min.js"></script>
    <script src="./resources/js/libraries/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
      function formatPlaytime(minutes) {
        var hours = Math.floor(minutes / 60);
        var mins = minutes % 60;
        return hours + " ч " + mins + " мин";
      }

      function updateTotalPlaytime() {
        var table = $("table").DataTable();
        var total = 0;

        table.rows({search:'applied'}).every(function() {
          var data = this.data();
          total += parseInt(data[3]) || 0;
        });

        var formattedTotal = formatPlaytime(total);
        $("#TotalPlaytime").html('Общее время игры\n' + formattedTotal);
      }

      $(document).ready(function () {
        $("table").each(function () {
          var tHead = $(this).find("tr:first").html();
          $(this).find("colgroup").remove();
          $(this).find("tr:first").remove();
          $(this)
            .find("tbody")
            .before("<thead>" + tHead + "</thead>");
        });

        var dataTable = $("table").DataTable({
          columnDefs: [
            {
              targets: 3,
              className: "playtimegradient",
              render: function (data, type, row, meta) {
                if (type === "display" || type === "filter") {
                  var hours = parseInt(parseInt(data) / 60);
                  var minutes = parseInt(data) % 60;
                  return hours + " ч " + minutes + " мин";
                }
                return data;
              },
              createdCell: function (td, cellData, rowData, row, col) {
                var maxPlayTime = _MAXPLAYTIME_;
                var percentage = (
                  (parseInt(cellData) / maxPlayTime) *
                  95
                ).toFixed(2);
                $(td).css("background-size", percentage + "% 85%");
              },
            },
            {
              targets: 7,
              render: function (data, type, row, meta) {
                if (type === "display" || type === "filter") {
                  var timestamp = parseInt(data);
                  // Handle NULL, 0, or invalid timestamps
                  if (isNaN(timestamp) || timestamp <= 0) {
                    return "Нет данных";
                  }
                  
                  // Handle different timestamp formats
                  // Standard Unix timestamps are 10-11 digits (seconds since 1970)
                  // Legacy data may have timestamps stored with extra precision:
                  //   - 12-14 digits: timestamp * 10000 (needs division by 10000)
                  //   - 15+ digits: timestamp * 100000 (needs division by 100000)
                  var TWELVE_DIGIT_THRESHOLD = 100000000000;  // 10^11
                  var FIFTEEN_DIGIT_THRESHOLD = 100000000000000;  // 10^14
                  var CENTISECOND_DIVISOR = 10000;
                  var MICROSECOND_DIVISOR = 100000;
                  
                  var utcSeconds = timestamp;
                  if (timestamp > TWELVE_DIGIT_THRESHOLD) {
                    // 12+ digit timestamp, divide by appropriate factor
                    if (timestamp > FIFTEEN_DIGIT_THRESHOLD) {
                      // 15+ digits: divide by 100000
                      utcSeconds = timestamp / MICROSECOND_DIVISOR;
                    } else {
                      // 12-14 digits: divide by 10000
                      utcSeconds = timestamp / CENTISECOND_DIVISOR;
                    }
                  }
                  
                  var date = new Date(0);
                  date.setUTCSeconds(utcSeconds);
                  // Verify the date is valid after conversion
                  if (isNaN(date.getTime())) {
                    return "Нет данных";
                  }
                  return date.toLocaleDateString(undefined, {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  });
                }
                return data;
              },
            },
          ],
          order: [
            [7, "desc"],
          ],
          ordering: true,
          paging: "numbers",
          pageLength: 8,
          lengthChange: false,
          searching: true,
          language: {
            search: "Поиск:",
            info: "Показано с _START_ по _END_ из _TOTAL_ записей",
            infoEmpty: "Показано с 0 по 0 из 0 записей",
            infoFiltered: "(отфильтровано из _MAX_ записей)",
            paginate: {
              first: "Первая",
              last: "Последняя",
              next: "Следующая",
              previous: "Предыдущая"
            },
            emptyTable: "Нет данных в таблице"
          }
        });

        dataTable.on('search.dt', updateTotalPlaytime);
        dataTable.on('length.dt', updateTotalPlaytime);

        $("#TotalPlaytime-placeholder")[0].insertAdjacentHTML(
          "beforeend",
          '<div id="TotalPlaytime">Общее время игры\n</div>'
        );

        var filterElement = $("#DataTables_Table_0_filter").detach();
        $("#filter-placeholder").append(filterElement);

        document
          .getElementById("Toggle-Pagination")
          .addEventListener("click", () => {
            if ($("table").DataTable().page.len() == 8) {
              document.getElementById("Toggle-Pagination").innerText =
                "Свернуть";
              $("table").DataTable().page.len(-1).draw();
            } else {
              document.getElementById("Toggle-Pagination").innerText =
                "Показать все";
              $("table").DataTable().page.len(8).draw();
            }
            updateTotalPlaytime();
          });

        $("#games-table-container").addClass("ready");
        updateTotalPlaytime();
      });
    </script>
  </head>

  <body>
    <div id="header-container">
      <div id="TotalPlaytime-placeholder"></div>
      <h1>Все игры</h1>
      <div id="filter-placeholder"></div>
    </div>
    <div id="main-panel">
      <div id="games-table-container">_GAMESTABLE_</div>
      <div id="button-container">
        <button class="custom-button" id="Toggle-Pagination">Показать все</button>
      </div>
    </div>
    <div id="navigation-bar">
      <button class="custom-button" id="summary-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/Summary.html';">Общая сводка</button>
      <button class="custom-button" id="gaming-time-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/GamingTime.html';">Время в играх</button>
      <button class="custom-button" id="most-played-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/MostPlayed.html';">Самые популярные</button>
      <button class="custom-button" id="all-games-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/AllGames.html';">Все игры</button>
      <button class="custom-button help-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/Manual.html';">?</button>
      <button class="custom-button" id="idle-time-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/IdleTime.html';">Время простоя</button>
      <button class="custom-button" id="session-history-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/SessionHistory.html';">История сессий</button>
      <button class="custom-button" id="games-per-platform-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/GamesPerPlatform.html';">Игры по платформам</button>
      <button class="custom-button" id="pc-vs-emu-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/PCvsEmulation.html';">ПК vs Эмуляция</button>
    </div>
  </body>
</html>
