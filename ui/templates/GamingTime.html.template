<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8">
    <title>Gaming Gaiden</title>
    <link
      rel="icon"
      type="image/x-icon"
      href="./resources/images/favicon.ico"
    />
    <link rel="stylesheet" href="./resources/css/theme.css" />
    <link rel="stylesheet" href="./resources/css/common.css" />
    <link rel="stylesheet" href="./resources/css/calendar-controls.css" />
    <link rel="stylesheet" href="./resources/css/GamingTime.css" />
    <link rel="stylesheet" href="./resources/css/GamingTime-calendar.css" />
    <script src="./resources/js/libraries/jquery-3.7.1.min.js"></script>
    <script src="./resources/js/libraries/chart.js"></script>
    <script src="./resources/js/libraries/chartjs-plugin-datalabels-2.0.0.js"></script>
    <script>
      $(document).ready(function () {
        $("table").each(function () {
          var tHead = $(this).find("tr:first").html();
          $(this).find("colgroup").remove();
          $(this).find("tr:first").remove();
          $(this)
            .find("tbody")
            .before("<thead>" + tHead + "</thead>");
        });
      });
    </script>
  </head>

  <body>
    <h1>Время, проведённое в играх</h1>
    <div id="main-panel">
      <div id="calendar-column">
        <div id="calendar-container">
          <div id="year-navigation">
            <button class="custom-button calendar-nav-btn" id="prev-year-button">&#11164;</button>
            <div id="year-display"></div>
            <button class="custom-button calendar-nav-btn" id="next-year-button">&#11166;</button>
          </div>
          <div id="month-grid">
            <button class="month-btn" data-month="0">Янв</button>
            <button class="month-btn" data-month="1">Фев</button>
            <button class="month-btn" data-month="2">Мар</button>
            <button class="month-btn" data-month="3">Апр</button>
            <button class="month-btn" data-month="4">Май</button>
            <button class="month-btn" data-month="5">Июн</button>
            <button class="month-btn" data-month="6">Июл</button>
            <button class="month-btn" data-month="7">Авг</button>
            <button class="month-btn" data-month="8">Сен</button>
            <button class="month-btn" data-month="9">Окт</button>
            <button class="month-btn" data-month="10">Ноя</button>
            <button class="month-btn" data-month="11">Дек</button>
          </div>
        </div>
      </div>
      <div id="chart-column">
        <div id="chart-container">
          <canvas id="gaming-time-chart"></canvas>
        </div>
        <div id="total-hours-display"></div>
      </div>
    </div>
    <div style="display: none">_DAILYPLAYTIMETABLE_</div>
    <script src="./resources/js/common.js"></script>
    <script src="./resources/js/calendar-controls.js"></script>
    <script src="./resources/js/GamingTime.js"></script>
    <div id="navigation-bar">
      <button class="custom-button" id="summary-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/Summary.html';">Общая сводка</button>
      <button class="custom-button" id="gaming-time-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/GamingTime.html';">Время в играх</button>
      <button class="custom-button" id="most-played-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/MostPlayed.html';">Самые популярные</button>
      <button class="custom-button" id="all-games-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/AllGames.html';">Все игры</button>
      <button class="custom-button help-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/Manual.html';">?</button>
      <button class="custom-button" id="idle-time-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/IdleTime.html';">Время простоя</button>
      <button class="custom-button" id="session-history-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/SessionHistory.html';">История сессий</button>
      <button class="custom-button" id="games-per-platform-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/GamesPerPlatform.html';">Игры по платформам</button>
      <button class="custom-button" id="pc-vs-emu-button" onclick="window.location.href='file:///C:/ProgramData/GamingGaiden/ui/PCvsEmulation.html';">ПК против эмуляции</button>
    </div>
  </body>
</html>
